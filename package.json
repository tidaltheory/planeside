{
  "name": "planeside",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "vite-ssg build",
    "dev": "TAILWIND_MODE=watch vite --port 3333 --open",
    "lens": "lens",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview-https": "serve dist",
    "test": "vitest",
    "test:e2e": "cypress open",
    "test:unit": "vitest",
    "typecheck": "vue-tsc --noEmit"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.vue": [
      "eslint --fix",
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.css": [
      "stylelint --fix",
      "prettier --write"
    ],
    "package.json": "prettier --write"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "useTabs": true,
    "overrides": [
      {
        "files": [
          "*.json",
          "*.yml"
        ],
        "options": {
          "tabWidth": 2,
          "useTabs": false
        }
      }
    ]
  },
  "dependencies": {
    "@vueuse/core": "8.7.5",
    "@vueuse/head": "0.7.6",
    "animejs": "3.2.1",
    "vue": "3.2.37",
    "vue-demi": "0.13.1",
    "vue-router": "4.0.16"
  },
  "devDependencies": {
    "@tidaltheory/lens": "0.5.2",
    "@typescript-eslint/eslint-plugin": "5.62.0",
    "@typescript-eslint/parser": "5.62.0",
    "@vitejs/plugin-vue": "2.3.4",
    "@vue/test-utils": "2.4.6",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.0",
    "eslint-config-prettier": "8.10.0",
    "eslint-plugin-vue": "9.27.0",
    "husky": "4.3.8",
    "lint-staged": "13.3.0",
    "postcss": "8.4.43",
    "postcss-html": "1.7.0",
    "prettier": "2.8.8",
    "prettier-plugin-packagejson": "2.5.2",
    "prettier-plugin-tailwindcss": "0.6.6",
    "stylelint": "14.16.1",
    "stylelint-config-prettier": "9.0.5",
    "stylelint-config-standard": "26.0.0",
    "tailwindcss": "3.4.10",
    "tailwindcss-capsize": "3.0.5",
    "tailwindcss-opentype": "1.1.0",
    "typescript": "4.9.5",
    "unplugin-auto-import": "0.18.2",
    "vite": "2.9.18",
    "vite-plugin-inspect": "0.8.7",
    "vite-plugin-md": "0.21.5",
    "vite-plugin-pages": "0.32.3",
    "vite-plugin-pwa": "0.20.2",
    "vite-plugin-vue-layouts": "0.11.0",
    "vite-ssg": "0.23.8",
    "vitest": "0.34.6",
    "vue-tsc": "0.40.13"
  }
}
